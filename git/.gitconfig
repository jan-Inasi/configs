[user]
	email = ignacymajkusiak@gmail.com
	name = jan-inasi
[core]
	editor = nvim
[alias]
	s = status
	ss = status --short
	b = branch
	graph = log --oneline --graph
	whoami = !git config user.name && git config user.email
	c = commit
	a = add
	d = diff
	co = checkout
	ll = log --pretty=format:'%C(auto)%h%Creset %C(dim)%ad%Creset %C(auto)%d%Creset%s' --date=short
[diff]
	algorithm = histogram
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
